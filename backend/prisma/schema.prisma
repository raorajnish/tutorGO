generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  SUPERADMIN
  OWNER
  ADMIN
  ACCOUNTANT
  FACULTY
  RECEPTION
  STUDENT
}

enum ModuleCode {
  ENQUIRY
  ADMISSION
  ATTENDANCE
  FEES
  PAYROLL
  EXPENSE
}

enum EnquirySource {
  WALK_IN
  REFERRAL
  SOCIAL
  PHONE
  OTHER
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CONVERTED
  LOST
}

enum EnquiryActivityType {
  CONTACTED
  CONVERTED
  LOST
}

enum LectureKind {
  LECTURE
  TEST
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  LATE
  HOLIDAY
  PRESENT_BIOMETRIC
}

enum MessageTemplateType {
  LECTURE_SCHEDULED
  LECTURE_CANCELLED
  ATTENDANCE_MARKED
  FEE_OVERDUE_REMINDER
  PAYROLL_PAYMENT_RECORDED
  /// Fires from the marks-entry route the moment a TestResult is written —
  /// the student's own portal notification and the parent's WhatsApp copy
  /// come from the same dispatch call. See changes-phase10.md §10.6.
  TEST_RESULT_ENTERED
}

enum PaymentMode {
  UPI
  CASH
  CARD
  BANK_TRANSFER
  CHEQUE
}

enum FeePlanType {
  ONE_TIME
  RECURRING
}

/// How FeeAccount.discount is interpreted — a flat rupee amount, or a
/// percentage of courseFee. FLAT is the default and matches every account
/// created before this column existed, so nothing changes for them.
enum DiscountType {
  FLAT
  PERCENT
}

enum FeeAccountStatus {
  ACTIVE
  CLOSED
}

enum SalaryType {
  FIXED
  PER_LECTURE
}

enum PayrollLineItemKind {
  SALARY
  LECTURE
}

enum PayrollRunStatus {
  DRAFT
  APPROVED
  PAID
}

// ---------------------------------------------------------------------------
// Plans — per-institute role headcount limits
// ---------------------------------------------------------------------------

/// A subscription tier, assigned per Institute (not per Organization — two
/// branches under the same org can be on different plans). Caps apply to the
/// institute-level roles only: ADMIN, ACCOUNTANT, FACULTY, RECEPTION, STUDENT.
/// OWNER is one-per-Organization and SUPERADMIN is platform-only, so neither
/// is capped here.
model Plan {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  description    String?
  maxAdmins      Int      @default(1)
  maxAccountants Int      @default(2)
  maxFaculty     Int      @default(5)
  maxReception   Int      @default(2)
  maxStudents    Int      @default(100)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  institutes Institute[]

  @@map("plans")
}

// ---------------------------------------------------------------------------
// Platform layer
// ---------------------------------------------------------------------------

/// One paying customer. Has exactly one Owner and one or more Institutes
/// (branches). Institutes never share data with each other, even though
/// they roll up to the same Organization.
model Organization {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  gstin     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String? @unique
  owner   User?   @relation("OrganizationOwner", fields: [ownerId], references: [id])

  institutes Institute[]

  @@map("organizations")
}

/// A single branch/campus. The hard tenant-isolation boundary — every
/// operational record (students, fees, attendance, ...) carries an
/// instituteId and is only ever queried scoped to one Institute at a time.
model Institute {
  id               String   @id @default(cuid())
  organizationId   String
  planId           String?
  code             String   @unique
  name             String
  email            String?
  phone            String?
  address          String?
  city             String?
  state            String?
  isActive         Boolean  @default(true)
  biometricEnabled Boolean  @default(false)
  onboardingStep   Int      @default(0)
  onboardingDone   Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  /// This institute's OWN headcount limits. Copied from the Plan at the moment
  /// the plan is assigned, then owned by the institute — editing the Plan row
  /// afterwards never moves an existing institute's ceiling, so a superadmin
  /// raising the "Standard" plan for new signups can't silently re-price or
  /// re-provision every institute already on it. A superadmin can also raise
  /// or lower any of these for one institute alone (PATCH
  /// /platform/institutes/:id/limits) without inventing a bespoke plan.
  ///
  /// Null means "never snapshotted" — only institutes that predate this
  /// column — and falls back to the live Plan values (lib/instituteLimits.ts)
  /// so nothing breaks before the backfill runs.
  maxAdmins       Int?
  maxAccountants  Int?
  maxFaculty      Int?
  maxReception    Int?
  maxStudents     Int?
  /// When the limits above were last snapshotted from a plan or hand-edited —
  /// shown in the platform UI so it's clear they're a point-in-time copy.
  planLimitsSetAt DateTime?

  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan              Plan?                    @relation(fields: [planId], references: [id])
  users             User[]
  modules           InstituteModule[]
  courses           Course[]
  subjects          Subject[]
  batches           Batch[]
  enquiries         Enquiry[]
  students          Student[]
  lectures          Lecture[]
  messageTemplates  MessageTemplate[]
  feeStructures     FeeStructure[]
  feeAccounts       FeeAccount[]
  payments          Payment[]
  salaryProfiles    SalaryProfile[]
  payrollPayments   PayrollPayment[]
  payrollRuns       PayrollRun[]
  notifications     Notification[]
  emailConfig       InstituteEmailConfig?
  whatsAppConfig    InstituteWhatsAppConfig?
  whatsAppTemplates WhatsAppTemplate[]
  outboundMessages  OutboundMessage[]
  expenseCategories ExpenseCategory[]
  events            Event[]
  expenses          Expense[]
  financeEntries    FinanceEntry[]
  tests             Test[]
  reminders         ScheduledReminder[]
  distributionItems DistributionItem[]
  leaveRequests     LeaveRequest[]

  @@index([organizationId])
  @@map("institutes")
}

model Module {
  id          String     @id @default(cuid())
  code        ModuleCode @unique
  label       String
  description String?
  createdAt   DateTime   @default(now())

  institutes InstituteModule[]

  @@map("modules")
}

model InstituteModule {
  id          String   @id @default(cuid())
  instituteId String
  moduleId    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  module    Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([instituteId, moduleId])
  @@map("institute_modules")
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------

model User {
  id                 String    @id @default(cuid())
  /// Set for ADMIN/FACULTY/RECEPTION/STUDENT (tied to exactly one institute).
  /// Null for SUPERADMIN (platform-only) and OWNER (tied to an Organization
  /// instead — see ownedOrganization).
  instituteId        String?
  email              String    @unique
  passwordHash       String
  fullName           String
  phone              String?
  role               Role
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  termsAcceptedAt    DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  institute           Institute?          @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  ownedOrganization   Organization?       @relation("OrganizationOwner")
  lecturesTaught      Lecture[]
  teachingAssignments FacultyAssignment[]
  notifications       Notification[]
  salaryProfile       SalaryProfile?
  passwordResetOtps   PasswordResetOtp[]
  expensesRecorded    Expense[]
  testsAuthored       Test[]              @relation("TestAuthor")
  testResultsEntered  TestResult[]        @relation("TestResultAuthor")
  pushSubscriptions   PushSubscription[]
  leaveRequests       LeaveRequest[]      @relation("LeaveRequester")
  leaveReviews        LeaveRequest[]      @relation("LeaveReviewer")
  /// Set only on a role=STUDENT login — the student row it grants access to.
  portalStudent       Student?            @relation("StudentPortalLogin")

  @@index([instituteId])
  @@map("users")
}

/// One browser/device registration for web push. A user can have several
/// (phone, laptop, ...); each is pushed to independently, and a subscription
/// that comes back 410 Gone from the push service (the browser unsubscribed
/// on its end) is deleted rather than retried.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// Short-lived 6-digit OTP for the forgot-password flow. codeHash is a bcrypt
/// hash — the plaintext code only ever exists in the email sent to the user.
model PasswordResetOtp {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_otps")
}

// ---------------------------------------------------------------------------
// Global platform config + logs
// ---------------------------------------------------------------------------

/// Singleton row (id = "default") — the platform's outbound SMTP transport,
/// used as the fallback whenever an institute hasn't configured its own
/// (see InstituteEmailConfig) — e.g. team invites before an owner has set
/// anything up, or any institute that never bothers to.
model EmailConfig {
  id           String   @id @default("default")
  host         String
  port         Int
  secure       Boolean  @default(false)
  username     String
  password     String
  fromName     String   @default("TutorGO")
  fromEmail    String
  isConfigured Boolean  @default(true)
  updatedAt    DateTime @updatedAt

  @@map("email_config")
}

/// An institute's own outbound SMTP transport, set by OWNER/ADMIN in
/// Settings → Email. When present and `isEnabled`, every email triggered for
/// that institute (payroll notifications, team invites, ...) goes out from
/// here instead of the platform's shared EmailConfig — see
/// services/mailer.ts's fallback order. `isEnabled` is a separate flag from
/// "has credentials saved" so an owner can pause institute-branded email
/// without deleting the configuration.
model InstituteEmailConfig {
  id          String   @id @default(cuid())
  instituteId String   @unique
  host        String
  port        Int
  secure      Boolean  @default(false)
  username    String
  password    String
  fromName    String
  fromEmail   String
  isEnabled   Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@map("institute_email_configs")
}

/// Meta WhatsApp Business Cloud API credentials, one per institute. First
/// genuinely encrypted secret in this schema (accessToken) — unlike
/// InstituteEmailConfig.password, this token grants broad send access on the
/// institute's WABA, not just one mailbox. See changes-phase9.md §9a.
model InstituteWhatsAppConfig {
  id                String   @id @default(cuid())
  instituteId       String   @unique
  /// AES-256-GCM ciphertext (lib/crypto.ts), never returned by any GET.
  accessToken       String
  phoneNumberId     String
  wabaId            String
  businessAccountId String?
  isEnabled         Boolean  @default(false)
  connectedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@map("institute_whatsapp_configs")
}

enum WhatsAppTemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

/// Local cache of an institute's Meta message templates — both ones synced
/// down from the WABA (APPROVED/PENDING/REJECTED) and drafts we suggest
/// on-device (DRAFT, metaTemplateId null) before the owner submits them.
model WhatsAppTemplate {
  id             String                 @id @default(cuid())
  instituteId    String
  metaTemplateId String?
  name           String
  language       String
  category       String
  status         WhatsAppTemplateStatus @default(DRAFT)
  bodyText       String
  /// Links an APPROVED template to one of MESSAGE_TEMPLATE_TYPES (lib/
  /// messageTemplates.ts) so the future sendMessage() dispatcher knows which
  /// Meta template to use per in-app trigger. Null until staff map it.
  mappedType     MessageTemplateType?
  lastSyncedAt   DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@unique([instituteId, name, language])
  @@map("whatsapp_templates")
}

enum OutboundMessageChannel {
  WHATSAPP
}

enum OutboundMessageStatus {
  QUEUED
  SENT
  FAILED
}

/// Delivery log for every WhatsApp send attempt — nothing fire-and-forget,
/// so a failure is visible and the webhook (routes/whatsapp.ts) has a row to
/// update via providerMessageId. See changes-phase9.md §9a.
model OutboundMessage {
  id                String                 @id @default(cuid())
  instituteId       String
  studentId         String?
  channel           OutboundMessageChannel @default(WHATSAPP)
  toPhone           String
  templateName      String
  payload           Json
  status            OutboundMessageStatus  @default(QUEUED)
  providerMessageId String?
  error             String?
  sentAt            DateTime?
  createdAt         DateTime               @default(now())

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  student   Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([instituteId, createdAt])
  @@index([providerMessageId])
  @@map("outbound_messages")
}

model MessageLog {
  id             String   @id @default(cuid())
  organizationId String?
  instituteId    String?
  toEmail        String
  subject        String
  purpose        String
  delivered      Boolean  @default(false)
  error          String?
  createdAt      DateTime @default(now())

  @@index([instituteId])
  @@index([organizationId])
  @@map("message_logs")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  instituteId    String?
  userId         String?
  action         String
  targetType     String?
  targetId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([instituteId])
  @@index([organizationId])
  @@map("audit_logs")
}

/// A real, persisted in-app notification — what NotificationDrawer.tsx reads
/// (replacing its earlier hardcoded demo list). Only makes sense for users
/// with a login; a no-login external staff member can't see this drawer, so
/// they're reached via email instead (see SalaryProfile.externalEmail) —
/// there's no in-app channel possible for them by construction.
model Notification {
  id          String    @id @default(cuid())
  instituteId String
  userId      String
  type        String
  title       String
  body        String
  metadata    Json?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([instituteId])
  @@map("notifications")
}

/// Open-ended enough to cover the real cases (electricity, rent, AMC,
/// painting) without pretending to be exhaustive — OTHER + the free-text
/// `title` carries anything that doesn't fit.
enum ReminderCategory {
  UTILITY
  RENT
  MAINTENANCE
  COMPLIANCE
  SUPPLIES
  OTHER
}

enum ReminderRepeat {
  NONE
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

/// Who hears about it when it fires. PRIVATE is the default deliberately —
/// a reminder someone sets for themselves must not silently notify their
/// boss. ADMINS is the opt-in for genuine institute-ops obligations (the
/// electricity bill, the rent) that the owner also needs to see.
enum ReminderAudience {
  PRIVATE
  ADMINS
}

/// A dated obligation that notifies its audience `leadDays` before it's due.
/// Distinct from `POST /org/reminders`, which broadcasts an ad-hoc message
/// to team roles *immediately* and stores nothing — this one is scheduled,
/// persistent, and optionally recurring. Fired by services/reminderScheduler.ts
/// (in-process ticker started in server.ts). See changes-phase8.md §8d.
model ScheduledReminder {
  id              String           @id @default(cuid())
  instituteId     String
  createdByUserId String
  title           String
  category        ReminderCategory @default(OTHER)
  /// The date the thing is actually due. For a repeating reminder this is
  /// always the *next* occurrence — the scheduler rolls it forward once the
  /// date has passed, rather than storing one row per cycle.
  dueDate         DateTime         @db.Date
  /// Every lead time this reminder notifies at, in days before `dueDate` —
  /// e.g. [90, 30, 15, 7, 1] pings four times as a deadline approaches. Plain
  /// Ints rather than an enum so the common presets and any custom number are
  /// the same thing. Stored sorted descending (earliest notification first).
  leadDays        Int[]
  repeat          ReminderRepeat   @default(NONE)
  audience        ReminderAudience @default(PRIVATE)
  notes           String?
  isActive        Boolean          @default(true)
  /// Display only — "last notified on".
  lastFiredAt     DateTime?

  // --- Scheduler cursor -----------------------------------------------------
  // Together these answer "when does this next need to notify, and for which
  // lead time?" without the scheduler having to compute anything per row.
  // Both are derived from dueDate + leadDays and are always rewritten in the
  // same operation as those (see reminderScheduler.reminderCursor), so they
  // can't drift from the values that justify them.
  //
  // Because lead times fire in descending order (90 → 30 → 7 → 1), the pending
  // one implies the rest: every larger lead has already fired, every smaller
  // one hasn't. That's why a single cursor is enough and no per-lead history
  // needs storing.

  /// Date of the next unfired notification (`dueDate - nextNotifyLead`).
  /// NULL once every lead time for the current `dueDate` has fired — which
  /// also drops the row out of the scheduler's index range entirely, so
  /// finished reminders are never re-read however many accumulate.
  nextNotifyOn   DateTime? @db.Date
  /// The lead time `nextNotifyOn` corresponds to. NULL alongside it.
  nextNotifyLead Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId, dueDate])
  /// Serves the scheduler's "what needs notifying?" query end-to-end. Rows
  /// with a NULL nextNotifyOn (nothing left to fire) fall outside the range
  /// and are never read.
  @@index([isActive, nextNotifyOn])
  /// Serves the scheduler's "what repeating reminder has gone stale?" query.
  @@index([isActive, repeat, dueDate])
  @@map("scheduled_reminders")
}

// ---------------------------------------------------------------------------
// Academics — Courses / Subjects / Batches (Phase 2)
// ---------------------------------------------------------------------------

/// Doubles as the institute's "class/standard" — e.g. "10th Standard" (code
/// "10"), "12th — JEE" (code "12JEE"). `code` is short, staff-defined once at
/// setup, and feeds directly into Student.studentCode generation — no
/// free-text parsing needed at admission time.
/// How a course prices itself. FLAT is the original behavior (one courseFee
/// per FeeStructure); SUBJECT_WISE computes a student's courseFee as the sum
/// of the subjects they actually selected. See changes-phase8.md §8c.
enum CourseFeeMode {
  FLAT
  SUBJECT_WISE
}

model Course {
  id             String   @id @default(cuid())
  instituteId    String
  name           String
  code           String
  durationMonths Int?
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// Declared once per course; every existing course stays FLAT, so nothing
  /// about today's Fees or Attendance behavior changes until a course is
  /// explicitly switched. Switching is blocked once the course has enrolled
  /// students or fee accounts — see assertFeeModeSwitchAllowed() in
  /// academics.ts and guard A in changes-phase8.md §8c (flipping a populated
  /// course would silently empty every one of its rosters).
  feeMode CourseFeeMode @default(FLAT)

  /// The single gate on student-portal access. There is deliberately no
  /// institute-wide switch alongside it: turning this off on every course
  /// already means "portal off here", with one less flag to keep in sync.
  /// Turning it off does not delete anything — the student's login simply
  /// stops authenticating (see middleware/auth.ts), and every attendance,
  /// test and fee record they have is untouched and reappears if it is
  /// turned back on. See changes-phase10.md §10.6.
  portalEnabled Boolean @default(false)

  /// Pre-fills FeeAccount.courseFee when creating a ONE_TIME plan for a
  /// student in this course — editable per-student, just a sane default.
  defaultFee        Decimal? @db.Decimal(10, 2)
  /// Same idea for RECURRING plans — pre-fills FeeAccount.monthlyAmount.
  defaultMonthlyFee Decimal? @db.Decimal(10, 2)

  institute         Institute           @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  batches           Batch[]
  enquiries         Enquiry[]
  students          Student[]
  subjects          CourseSubject[]
  assignments       FacultyAssignment[]
  feeStructures     FeeStructure[]
  tests             Test[]
  distributionItems DistributionItem[]

  @@unique([instituteId, code])
  @@index([instituteId])
  @@map("courses")
}

model Subject {
  id          String   @id @default(cuid())
  instituteId String
  name        String
  shortCode   String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  institute         Institute                 @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  courses           CourseSubject[]
  lectures          Lecture[]
  assignments       FacultyAssignment[]
  tests             Test[]
  feeStructureLines FeeStructureSubjectLine[]
  studentSubjects   StudentSubject[]

  @@unique([instituteId, shortCode])
  @@index([instituteId])
  @@map("subjects")
}

/// Explicit many-to-many: a subject (e.g. "Physics") is often taught across
/// several courses (e.g. both a JEE and a NEET course), not owned by one.
model CourseSubject {
  id        String @id @default(cuid())
  courseId  String
  subjectId String

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([courseId, subjectId])
  @@index([subjectId])
  @@map("course_subjects")
}

model Batch {
  id          String    @id @default(cuid())
  instituteId String
  courseId    String
  name        String
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  institute Institute      @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  course    Course         @relation(fields: [courseId], references: [id])
  students  StudentBatch[]
  lectures  Lecture[]

  @@index([instituteId])
  @@index([courseId])
  @@map("batches")
}

// ---------------------------------------------------------------------------
// Enquiry → Admission → Students (Phase 3)
// ---------------------------------------------------------------------------

model Enquiry {
  id               String        @id @default(cuid())
  instituteId      String
  name             String
  phone            String
  courseId         String?
  source           EnquirySource @default(OTHER)
  status           EnquiryStatus @default(NEW)
  nextFollowUpDate DateTime?     @db.Date
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  institute  Institute         @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  course     Course?           @relation(fields: [courseId], references: [id])
  student    Student?
  activities EnquiryActivity[]

  @@index([instituteId, status])
  @@map("enquiries")
}

/// Follow-up trail — one row per contact attempt / status transition, kept
/// forever so the pipeline history survives even after the lead converts or
/// goes cold. `createdByName` is a point-in-time snapshot (not a relation) so
/// the trail still reads correctly if the staff account is later removed.
model EnquiryActivity {
  id               String              @id @default(cuid())
  enquiryId        String
  type             EnquiryActivityType
  note             String?
  nextFollowUpDate DateTime?           @db.Date
  createdByName    String?
  createdAt        DateTime            @default(now())

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([enquiryId])
  @@map("enquiry_activities")
}

/// Internal bookkeeping only — one gapless sequence per (institute, admission
/// year, course code), used to generate Student.studentCode atomically.
model StudentCodeCounter {
  id          String @id @default(cuid())
  instituteId String
  year        Int
  courseCode  String
  seq         Int    @default(0)

  @@unique([instituteId, year, courseCode])
  @@map("student_code_counters")
}

model Student {
  id            String    @id @default(cuid())
  instituteId   String
  studentCode   String    @unique
  enquiryId     String?   @unique
  courseId      String
  name          String
  email         String    @unique
  phone         String?
  parentPhone   String?
  dob           DateTime? @db.Date
  fatherName    String?
  motherName    String?
  school        String?
  admissionDate DateTime  @db.Date
  fingerprintId String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  /// True iff this student was created via bulk-precreate. Permanent — unlike
  /// `selfFillPin`, this is never cleared, because it's the only reliable way
  /// to answer "did this row ever go through self-fill" once the PIN itself
  /// is gone after completion. Drives the staff status view (which must show
  /// filled AND pending rows, not just pending) and distinguishes "no PIN
  /// because never bulk-precreated" from "no PIN because already completed"
  /// in routes/public.ts. See changes-phase8.md §8f.
  selfFillEligible   Boolean   @default(false)
  /// Null = admitted the normal staff-entered way, or bulk-precreated and
  /// still awaiting self-fill. Set = the student has submitted the public
  /// form. Staff can clear this again via reopen to let a student resubmit.
  profileCompletedAt DateTime?
  /// The random 4-digit code printed on the roster export alongside the
  /// student ID — the public form's only identity check beyond the ID
  /// itself. Cleared once `profileCompletedAt` is set (nothing left to
  /// protect), and regenerated on reopen (the old one was never re-shown to
  /// the student after the first export, so it can't be reused — staff must
  /// hand out the new one, same as at bulk-precreate).
  selfFillPin        String?
  /// Failed-PIN counter for the lockout in routes/public.ts. DB-backed
  /// (unlike the IP-based rate limiter) specifically so it holds even if a
  /// guesser spreads attempts across many IPs or app instances.
  selfFillAttempts   Int       @default(0)
  selfFillLockedAt   DateTime?

  // --- Student portal (Phase 10.6) -----------------------------------------
  // Portal *status* is never stored — it is derived on every read from these
  // two columns plus the live course flag, the same "derive, don't store"
  // principle used for FeeInstallment and DistributionReceipt status. A
  // stored enum would drift the moment a course toggled or a student moved.
  // See lib/portalAccess.ts.

  /// The student's login, once staff have explicitly issued one. Null means
  /// no login has ever been created — which is every student by default: a
  /// new admission never gets one automatically.
  userId                  String? @unique
  /// The course the CURRENT credential was issued against. Compared with the
  /// live `courseId` to detect "this student has moved course, the existing
  /// login no longer matches their enrollment and must be re-issued".
  portalIssuedForCourseId String?

  institute            Institute             @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  /// SetNull, not Cascade: deleting the login must never delete the student.
  user                 User?                 @relation("StudentPortalLogin", fields: [userId], references: [id], onDelete: SetNull)
  enquiry              Enquiry?              @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  course               Course                @relation(fields: [courseId], references: [id])
  batches              StudentBatch[]
  subjects             StudentSubject[]
  attendance           AttendanceRecord[]
  testResults          TestResult[]
  feeAccount           FeeAccount?
  distributionReceipts DistributionReceipt[]
  outboundMessages     OutboundMessage[]

  @@index([instituteId, isActive])
  @@index([courseId])
  @@map("students")
}

/// Which subjects a student is enrolled in on a SUBJECT_WISE course — doing
/// double duty as "what they're paying for" and "what they appear on the
/// roster for", so free and paid subjects are one uniform source of truth
/// rather than two kinds of enrollment. Written only at fee-account creation.
///
/// `amount` is snapshotted from the chosen FeeStructure's subject line at
/// enrollment, on the same principle as FeeAccount.finalFee: repricing a
/// structure next year must never silently reprice a student already paying
/// the old rate.
///
/// `joinedAt` copies StudentBatch.joinedAt — NOT the date the fee account was
/// created. Guard B in changes-phase8.md §8c: deriveRoster filters
/// `joinedAt <= date`, so stamping "today" on a student who joined the batch
/// months earlier would erase them from every earlier roster while their
/// AttendanceRecord rows survive — attendance records for someone the roster
/// says was never there.
model StudentSubject {
  id        String    @id @default(cuid())
  studentId String
  subjectId String
  amount    Decimal   @db.Decimal(10, 2)
  /// False = dropped mid-course. Independent of `amount` because dropping a
  /// complementary subject is a real enrollment decision even though it
  /// changes no money. Deactivating only ever affects the roster — never an
  /// installment (see "correct vs. drop" in §8c).
  isActive  Boolean   @default(true)
  joinedAt  DateTime  @db.Date
  leftAt    DateTime? @db.Date

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([studentId, subjectId])
  @@index([subjectId])
  @@map("student_subjects")
}

/// Batch enrollment history — never edited or deleted after the fact.
/// Reassigning a student closes the currently-open row (leftAt) and opens a
/// new one, rather than mutating which batch a row points to.
model StudentBatch {
  id        String    @id @default(cuid())
  studentId String
  batchId   String
  joinedAt  DateTime  @db.Date
  leftAt    DateTime? @db.Date

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch   Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([batchId])
  @@map("student_batches")
}

// ---------------------------------------------------------------------------
// Attendance (Phase 4a — staff-facing only; student self-view deferred)
// ---------------------------------------------------------------------------

/// One scheduled class session. Roster is derived at read time from
/// StudentBatch rows active on `date`, never stored here — so a lecture
/// never goes stale if a student is later reassigned to a different batch.
///
/// A test session is the SAME row with kind = TEST and testId set, rather
/// than a parallel table: lecture history, the roster/mark endpoints, and
/// payroll's per-lecture generator then all work on tests unchanged. In
/// particular `facultyId` doubles as "the invigilator" for TEST rows, which
/// is what makes payroll correct for free — generateLectureLineItems only
/// pays PER_LECTURE profiles, so a monthly-salaried invigilator gets nothing
/// extra and an OWNER (who can't hold a SalaryProfile) never generates pay.
model Lecture {
  id           String      @id @default(cuid())
  instituteId  String
  batchId      String
  subjectId    String
  facultyId    String
  kind         LectureKind @default(LECTURE)
  testId       String?
  date         DateTime    @db.Date
  startTime    DateTime    @db.Time
  endTime      DateTime    @db.Time
  cancelledAt  DateTime?
  cancelReason String?
  note         String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  institute       Institute          @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  batch           Batch              @relation(fields: [batchId], references: [id])
  subject         Subject            @relation(fields: [subjectId], references: [id])
  faculty         User               @relation(fields: [facultyId], references: [id])
  test            Test?              @relation(fields: [testId], references: [id], onDelete: Cascade)
  attendance      AttendanceRecord[]
  results         TestResult[]
  payrollLineItem PayrollLineItem?

  @@index([instituteId, date])
  @@index([batchId, date])
  @@index([testId])
  @@map("lectures")
}

/// A test definition — the paper, the marks scheme, the instructions. It is
/// scheduled into one Lecture row (kind = TEST) per batch it's held for, so
/// one Test can span several batches on different dates/slots.
model Test {
  id              String   @id @default(cuid())
  instituteId     String
  courseId        String
  subjectId       String
  title           String
  totalMarks      Int
  passingMarks    Int?
  instructions    String?
  /// URL of the question paper. Optional — a test can be scheduled with no
  /// paper attached at all. Served from Cloudinary when configured, else from
  /// local disk (see services/uploads.ts).
  paperAssetUrl      String?
  paperAssetType     String?
  paperAssetName     String?
  /// Handle for deleting the stored asset. Null on rows uploaded before this
  /// column existed — those keep working, they just can't be cleaned up
  /// automatically, so no backfill is needed.
  paperAssetPublicId String?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institute Institute    @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  course    Course       @relation(fields: [courseId], references: [id])
  subject   Subject      @relation(fields: [subjectId], references: [id])
  createdBy User         @relation("TestAuthor", fields: [createdByUserId], references: [id])
  sessions  Lecture[]
  results   TestResult[]

  @@index([instituteId])
  @@map("tests")
}

/// One student's marks for one test session. Only written for students whose
/// attendance on that session is PRESENT/PRESENT_BIOMETRIC/LATE — enforced in
/// the route, since "marks for an absentee" is always a data-entry mistake.
model TestResult {
  id              String   @id @default(cuid())
  testId          String
  lectureId       String
  studentId       String
  marksObtained   Decimal  @db.Decimal(6, 2)
  remarks         String?
  enteredByUserId String
  enteredAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  test      Test    @relation(fields: [testId], references: [id], onDelete: Cascade)
  lecture   Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enteredBy User    @relation("TestResultAuthor", fields: [enteredByUserId], references: [id])

  @@unique([lectureId, studentId])
  @@index([testId])
  @@index([studentId])
  @@map("test_results")
}

model AttendanceRecord {
  id         String           @id @default(cuid())
  lectureId  String
  studentId  String
  status     AttendanceStatus
  markedAt   DateTime         @default(now())
  markedById String?

  lecture Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lectureId, studentId])
  @@index([studentId])
  @@map("attendance_records")
}

/// Which courses (and optionally which specific subjects within them) a
/// faculty member is eligible to teach. A course with no subject-scoped rows
/// means "all of that course's linked subjects" — the common case. No DB
/// uniqueness on [facultyId, courseId, subjectId]: Postgres treats every
/// NULL as distinct, so the API always replaces a faculty's full set in one
/// transaction (delete-then-recreate) rather than relying on a constraint.
model FacultyAssignment {
  id        String  @id @default(cuid())
  facultyId String
  courseId  String
  subjectId String?

  faculty User     @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([facultyId])
  @@index([courseId])
  @@map("faculty_assignments")
}

/// One row per (institute, type). Missing row = the frontend falls back to a
/// built-in default string, so institutes that never touch Settings still
/// get a usable WhatsApp-ready message.
model MessageTemplate {
  id          String              @id @default(cuid())
  instituteId String
  type        MessageTemplateType
  body        String

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@unique([instituteId, type])
  @@map("message_templates")
}

// ---------------------------------------------------------------------------
// Fees (Phase 5a — staff-facing only; student self-view deferred)
// ---------------------------------------------------------------------------

/// A reusable, course-scoped fee template ("10th Standard — 3 Installments
/// ₹30,000", "JEE Batch — Monthly ₹5,000"), managed from Academics alongside
/// Course/Subject/Batch. Attaching one to a student snapshots its values onto
/// a new FeeAccount below — editing or deactivating a structure never
/// retroactively reprices students already attached to it.
model FeeStructure {
  id               String      @id @default(cuid())
  instituteId      String
  courseId         String
  name             String
  planType         FeePlanType
  courseFee        Decimal?    @db.Decimal(10, 2)
  installmentCount Int?
  monthlyAmount    Decimal?    @db.Decimal(10, 2)
  billingDay       Int?
  isActive         Boolean     @default(true)
  /// The structure SetupFeeAccountModal pre-selects for this course. At most
  /// one per course, enforced by clearOtherDefaults() in academics.ts (not a
  /// DB constraint, since Postgres partial-unique-per-course needs a raw
  /// index Prisma push won't manage cleanly).
  isDefault        Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  institute    Institute                 @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  course       Course                    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  feeAccounts  FeeAccount[]
  subjectLines FeeStructureSubjectLine[]

  @@index([instituteId])
  @@index([courseId])
  @@map("fee_structures")
}

/// Per-subject pricing for a SUBJECT_WISE FeeStructure. Prices live here
/// rather than on CourseSubject so two cohorts can coexist at different rates
/// ("12th Science — Batch 2026-27" and "...2027-28" are simply two structures
/// on the same course); CourseSubject stays a bare join answering "which
/// subjects does this course offer", never "what do they cost".
///
/// A SUBJECT_WISE structure must carry a line for EVERY CourseSubject on its
/// course — enforced in academics.ts, not by the DB. Guard C in
/// changes-phase8.md §8c: a missing line means no student ever gets a
/// StudentSubject for that subject, so every one of its lectures derives an
/// empty roster, silently and forever.
model FeeStructureSubjectLine {
  id             String  @id @default(cuid())
  feeStructureId String
  subjectId      String
  /// 0 = complementary (English, IT) — included with a paid enrollment
  /// rather than sold separately. Complementary subjects still get a
  /// StudentSubject row, because they drive rosters exactly as much as
  /// paid ones do.
  amount         Decimal @default(0) @db.Decimal(10, 2)

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id])

  @@unique([feeStructureId, subjectId])
  @@index([subjectId])
  @@map("fee_structure_subject_lines")
}

/// One per student. ONE_TIME accounts use courseFee/discount/finalFee/
/// installmentCount; RECURRING accounts use monthlyAmount/billingDay instead
/// (those fields stay null) — see changes.md's Fees addendum. `finalFee` is
/// stored (not computed on read) so a later change to Course.defaultFee
/// never silently reprices an existing student's account. Values are
/// snapshotted from the attached FeeStructure at creation time; `feeStructureId`
/// is kept only for provenance/display.
model FeeAccount {
  id               String           @id @default(cuid())
  instituteId      String
  studentId        String           @unique
  feeStructureId   String?
  planType         FeePlanType
  status           FeeAccountStatus @default(ACTIVE)
  courseFee        Decimal?         @db.Decimal(10, 2)
  discount         Decimal?         @default(0) @db.Decimal(10, 2)
  /// FLAT = discount is a rupee amount; PERCENT = discount is 0-100, applied
  /// to courseFee. See lib/feeMath.ts for the one place finalFee is derived
  /// from these two fields.
  discountType     DiscountType     @default(FLAT)
  finalFee         Decimal?         @db.Decimal(10, 2)
  installmentCount Int?
  monthlyAmount    Decimal?         @db.Decimal(10, 2)
  billingDay       Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  institute    Institute        @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure?    @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
  installments FeeInstallment[]
  payments     Payment[]

  @@index([instituteId])
  @@index([feeStructureId])
  @@map("fee_accounts")
}

/// Status is *derived*, not stored — this table stores only the facts
/// (amount owed, amount paid), never a status enum that could drift out of
/// sync with the payments that are supposed to justify it. `originalDueDate`
/// is set once, on the first reschedule only. `paidAmount` can never exceed
/// `amount` — enforced by the waterfall-allocation payment engine in fees.ts,
/// not by a DB constraint (Decimal comparison isn't expressible as one).
model FeeInstallment {
  id                   String    @id @default(cuid())
  feeAccountId         String
  seq                  Int
  dueDate              DateTime  @db.Date
  originalDueDate      DateTime? @db.Date
  amount               Decimal   @db.Decimal(10, 2)
  paidAmount           Decimal   @default(0) @db.Decimal(10, 2)
  waived               Boolean   @default(false)
  /// True when this installment's `amount` was increased by a shortfall
  /// carried forward from an earlier installment that was settled short
  /// (see fees.ts POST /payments, settleAndCarryForward) — purely a display
  /// hint so staff aren't confused why the amount doesn't match what was
  /// originally quoted; never read for any calculation.
  adjustedFromPrevious Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  feeAccount  FeeAccount          @relation(fields: [feeAccountId], references: [id], onDelete: Cascade)
  allocations PaymentAllocation[]

  @@unique([feeAccountId, seq])
  @@map("fee_installments")
}

/// One payment transaction (one receipt). A single payment can settle across
/// several installments — see PaymentAllocation — so it's linked to the
/// FeeAccount directly, not to one installment. Never hard-deleted — a
/// wrongly-recorded one is voided (every allocation reversed, row kept with
/// voidedAt/voidReason for audit) rather than removed, so the receipt-number
/// sequence and payment history stay trustworthy.
model Payment {
  id              String      @id @default(cuid())
  instituteId     String
  feeAccountId    String
  amount          Decimal     @db.Decimal(10, 2)
  mode            PaymentMode
  paidOn          DateTime    @db.Date
  receiptNumber   String
  notes           String?
  createdByUserId String?
  voidedAt        DateTime?
  voidReason      String?
  voidedByUserId  String?
  createdAt       DateTime    @default(now())

  /// Opaque, unguessable — the auth for GET /public/receipts/:token. Never
  /// the sequential receiptNumber (guessable: try the next SEQ) and never the
  /// cuid id (not designed to be shared). Generated once at creation, stable
  /// for the life of the payment. Null on rows created before this column
  /// existed; those simply have no public link until backfilled.
  publicToken          String?   @unique
  /// Set when staff pull the "Revoke link" trigger — a public request for a
  /// revoked token 404s exactly like one that never had a link, but the
  /// receipt itself and the payment record are completely unaffected.
  publicTokenRevokedAt DateTime?

  institute   Institute           @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  feeAccount  FeeAccount          @relation(fields: [feeAccountId], references: [id], onDelete: Cascade)
  allocations PaymentAllocation[]

  // Receipt numbers are only meant to be unique per institute (ReceiptCounter
  // is scoped [instituteId, yearMonth] already) — a bare @unique here was
  // global, so the first payment of a month collided across DIFFERENT
  // institutes whenever both happened to land on the same counter value.
  // Found and fixed alongside §8a. See changes-phase8.md.
  @@unique([instituteId, receiptNumber])
  @@index([instituteId])
  @@index([feeAccountId])
  @@map("payments")
}

/// One line item within a Payment — how much of that one transaction went
/// toward one specific installment. sum(allocations.amount) for a payment
/// always equals payment.amount, enforced transactionally in fees.ts (never
/// trusted from client input). This is what makes "pay ₹14,000 against a
/// ₹10,500 installment" correctly close that installment and roll the
/// ₹3,500 excess into the next one, instead of silently over-crediting a
/// single installment past its target.
model PaymentAllocation {
  id            String  @id @default(cuid())
  paymentId     String
  installmentId String
  amount        Decimal @db.Decimal(10, 2)

  payment     Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  installment FeeInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([installmentId])
  @@map("payment_allocations")
}

/// Same atomic-upsert pattern as StudentCodeCounter — one gapless sequence
/// per (institute, year+month), used to generate Payment.receiptNumber
/// (RCT-YYMM-SEQ).
model ReceiptCounter {
  id          String @id @default(cuid())
  instituteId String
  yearMonth   String
  seq         Int    @default(0)

  @@unique([instituteId, yearMonth])
  @@map("receipt_counters")
}

// ---------------------------------------------------------------------------
// Payroll (Phase 6 — see changes.md addendum for full design)
// ---------------------------------------------------------------------------

/// A payable person — either a platform User (any staff role) or someone
/// entirely outside the platform (no login, no User row). PER_LECTURE is
/// only valid when userId is set and that User's role is FACULTY, since
/// lecture attribution runs through Lecture.facultyId -> User.id. Rates are
/// snapshotted onto each generated PayrollLineItem at creation time — the
/// same FeeStructure->FeeAccount snapshot pattern — so a later rate change
/// never retroactively reprices an already-generated period.
model SalaryProfile {
  id             String     @id @default(cuid())
  instituteId    String
  userId         String?    @unique
  externalName   String?
  /// Optional contact info for no-login staff — entirely optional (never
  /// required to set up a profile). When present, payment notifications go
  /// here by email; platform staff (userId set) use their User.email
  /// instead. With neither, no email goes out — the in-app notification
  /// (for userId-linked profiles) or the copy-to-WhatsApp payslip (either
  /// kind) are the fallback.
  externalEmail  String?
  externalPhone  String?
  title          String?
  salaryType     SalaryType
  monthlyRate    Decimal?   @db.Decimal(10, 2)
  perLectureRate Decimal?   @db.Decimal(10, 2)
  isActive       Boolean    @default(true)
  /// Set automatically the moment isActive flips to false, cleared on
  /// reactivation. Used to pro-rate the FIXED-salary line item for whatever
  /// period contains the departure date, and to cap PER_LECTURE generation
  /// at their last day — see services/payrollSync.ts.
  deactivatedAt  DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  lineItems PayrollLineItem[]
  payments  PayrollPayment[]

  @@index([instituteId])
  @@map("salary_profiles")
}

/// One earned amount, generated lazily (never all at once). `periodMonth` is
/// "YYYY-MM". `lectureId` is set only for LECTURE rows; nullable + a plain
/// unique constraint works because Postgres treats every NULL as distinct,
/// the same trick already relied on for FacultyAssignment.subjectId.
model PayrollLineItem {
  id              String              @id @default(cuid())
  salaryProfileId String
  kind            PayrollLineItemKind
  periodMonth     String
  lectureId       String?             @unique
  label           String
  amount          Decimal             @db.Decimal(10, 2)
  paidAmount      Decimal             @default(0) @db.Decimal(10, 2)
  createdAt       DateTime            @default(now())

  salaryProfile SalaryProfile              @relation(fields: [salaryProfileId], references: [id], onDelete: Cascade)
  lecture       Lecture?                   @relation(fields: [lectureId], references: [id], onDelete: SetNull)
  allocations   PayrollPaymentAllocation[]

  @@index([salaryProfileId, periodMonth])
  @@map("payroll_line_items")
}

/// One payout transaction. Mirrors Payment: never hard-deleted, corrected via
/// void. Can span multiple periods/line items in one transaction.
model PayrollPayment {
  id              String      @id @default(cuid())
  instituteId     String
  salaryProfileId String
  amount          Decimal     @db.Decimal(10, 2)
  mode            PaymentMode
  paidOn          DateTime    @db.Date
  notes           String?
  createdByUserId String?
  voidedAt        DateTime?
  voidReason      String?
  voidedByUserId  String?
  createdAt       DateTime    @default(now())

  institute     Institute                  @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  salaryProfile SalaryProfile              @relation(fields: [salaryProfileId], references: [id], onDelete: Cascade)
  allocations   PayrollPaymentAllocation[]

  @@index([instituteId])
  @@index([salaryProfileId])
  @@map("payroll_payments")
}

/// lineItemId nullable = the *advance* case: the portion of a payment not yet
/// matched to a specific line item, because none existed yet at payment time.
/// sum(allocations.amount) for a payment always equals payment.amount,
/// enforced in payroll.ts. An advance row's `amount` is mutated down as new
/// line items are generated and consume it — a running balance, not a
/// settled fact, until fully absorbed.
model PayrollPaymentAllocation {
  id         String  @id @default(cuid())
  paymentId  String
  lineItemId String?
  amount     Decimal @db.Decimal(10, 2)

  payment  PayrollPayment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  lineItem PayrollLineItem? @relation(fields: [lineItemId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([lineItemId])
  @@map("payroll_payment_allocations")
}

/// One per (institute, periodMonth). "In scope" for a run is always derived
/// (every PayrollLineItem across every active SalaryProfile with that
/// periodMonth) — a run is a status + approval record, not a second copy of
/// the data.
model PayrollRun {
  id               String           @id @default(cuid())
  instituteId      String
  periodMonth      String
  status           PayrollRunStatus @default(DRAFT)
  approvedAt       DateTime?
  approvedByUserId String?
  paidAt           DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@unique([instituteId, periodMonth])
  @@map("payroll_runs")
}

// ---------------------------------------------------------------------------
// Expenses
// ---------------------------------------------------------------------------

/// Per-institute, customizable — every institute is auto-seeded with a
/// standard default set on creation (see expenseDefaults.ts), then
/// owners/admins can add, rename, or deactivate their own on top.
model ExpenseCategory {
  id          String   @id @default(cuid())
  instituteId String
  name        String
  kind        String   @default("EXPENSE") // "EXPENSE" | "INCOME"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  expenses  Expense[]

  @@unique([instituteId, name])
  @@index([instituteId])
  @@map("expense_categories")
}

/// A named occasion (e.g. "Annual Day 2026") that expenses can be tagged
/// against, so spend is visible both by category and by event.
model Event {
  id          String   @id @default(cuid())
  instituteId String
  name        String
  notes       String?
  createdAt   DateTime @default(now())

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  expenses  Expense[]

  @@index([instituteId])
  @@map("events")
}

model Expense {
  id              String      @id @default(cuid())
  instituteId     String
  categoryId      String
  eventId         String?
  title           String
  amount          Decimal     @db.Decimal(10, 2)
  date            DateTime
  mode            PaymentMode
  referenceNo     String?
  notes           String?
  createdByUserId String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  institute    Institute       @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  category     ExpenseCategory @relation(fields: [categoryId], references: [id])
  event        Event?          @relation(fields: [eventId], references: [id])
  createdBy    User            @relation(fields: [createdByUserId], references: [id])
  financeEntry FinanceEntry?

  @@index([instituteId, date])
  @@index([eventId])
  @@map("expenses")
}

/// Shared mirror table for the combined Ledger (§2.13): every Expense writes
/// one row here. Fee Payments and PayrollPayments aren't mirrored yet — the
/// Ledger query reads those two tables directly and merges them with
/// FinanceEntry rows at query time (see routes/expenses.ts ledger endpoint).
model FinanceEntry {
  id          String   @id @default(cuid())
  instituteId String
  kind        String // "INCOME" | "EXPENSE" | "PAYROLL"
  sourceType  String // "EXPENSE" | "PAYMENT" | "PAYROLL_PAYMENT"
  sourceId    String
  amount      Decimal  @db.Decimal(10, 2)
  date        DateTime
  description String
  expenseId   String?  @unique
  createdAt   DateTime @default(now())

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  expense   Expense?  @relation(fields: [expenseId], references: [id])

  @@index([instituteId, date])
  @@index([sourceType, sourceId])
  @@map("finance_entries")
}

// ---------------------------------------------------------------------------
// Distribution tracking (books, bags, T-shirts, digests — any physical item
// handed out to students). Generic item + per-student receipt, not a bespoke
// model per item type. See changes-phase8.md §8e.
// ---------------------------------------------------------------------------

model DistributionItem {
  id          String   @id @default(cuid())
  instituteId String
  name        String
  /// Null = institute-wide (every active student gets a receipt row).
  /// Set = scoped to one course (only that course's active students do).
  courseId    String?
  /// Optional stock count — display-only, never enforced against the number
  /// of receipts marked received (a mismatch is a real-world inventory
  /// question for staff to notice, not something the app should block on).
  totalSets   Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  institute Institute             @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  course    Course?               @relation(fields: [courseId], references: [id], onDelete: SetNull)
  receipts  DistributionReceipt[]

  @@index([instituteId, isActive])
  @@index([courseId])
  @@map("distribution_items")
}

/// One row per (item, student) pair, created eagerly — for every
/// currently-enrolled matching student when the item is created, and for
/// every newly-admitted matching student afterward (hooked into
/// admission.ts). Eager rather than lazy because "who hasn't received it
/// yet" is the whole point of this feature and needs every student
/// represented from day one, not just the ones already marked.
///
/// `receivedAt: null` = pending — status derived from a fact, not a stored
/// enum, same principle as FeeInstallment.
model DistributionReceipt {
  id                 String    @id @default(cuid())
  distributionItemId String
  studentId          String
  receivedAt         DateTime? @db.Date
  notes              String?
  updatedByUserId    String?
  updatedAt          DateTime  @updatedAt

  item    DistributionItem @relation(fields: [distributionItemId], references: [id], onDelete: Cascade)
  student Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([distributionItemId, studentId])
  @@index([studentId])
  @@map("distribution_receipts")
}

// ---------------------------------------------------------------------------
// Staff leave (changes-phase10.md §10.4)
// ---------------------------------------------------------------------------

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// A staff member's own request for one or more days off. Deliberately does
/// NOT touch PayrollLineItem/SalaryProfile — an approved leave has no
/// automatic effect on pay in this phase (FIXED salary is unaffected;
/// PER_LECTURE pay is already zero for a day nothing was taught). Whether
/// unpaid leave should deduct from a FIXED salary is a policy decision left
/// for a follow-up once an institute actually asks for it — see phase10 doc.
model LeaveRequest {
  id               String      @id @default(cuid())
  instituteId      String
  userId           String
  startDate        DateTime    @db.Date
  endDate          DateTime    @db.Date
  reason           String
  status           LeaveStatus @default(PENDING)
  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNote       String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  institute  Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user       User      @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?     @relation("LeaveReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([instituteId, userId])
  @@index([instituteId, status])
  @@map("leave_requests")
}
