DATABASE_URL="postgresql://user:password@127.0.0.1:5432/tutorgodb?schema=public"

JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

PORT=4000
NODE_ENV=development
FRONTEND_URL="http://127.0.0.1:3000"

SUPERADMIN_EMAIL="admin@example.com"
SUPERADMIN_PASSWORD="ChangeMe@2026"
SUPERADMIN_NAME="Platform Admin"

# 32-byte key, hex-encoded (64 hex chars) — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="change-me-64-hex-chars"

# WhatsApp Cloud API — platform-level (one Meta App backs every institute's
# connected WABA; each institute's own accessToken/phoneNumberId/wabaId are
# stored per-institute in InstituteWhatsAppConfig, not here).
WHATSAPP_APP_SECRET="change-me"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="change-me"
