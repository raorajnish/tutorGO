# Backend origin. Used by the /api/* rewrite in next.config.ts, so requests
# from the browser stay same-origin and never hit CORS in development.
# Defaults to http://127.0.0.1:4000 when unset.
NEXT_PUBLIC_API_URL="http://127.0.0.1:4000"

# Web push. MUST be byte-identical to VAPID_PUBLIC_KEY in backend/.env —
# the browser records this value when it subscribes, and the push service
# rejects any send signed by a different keypair.
#
# Generate the pair once, in backend/:  npx web-push generate-vapid-keys
# Leave blank to disable push; the in-app notification bell still works.
#
# NEXT_PUBLIC_ means this is compiled into the client bundle and is public by
# design — that's correct here. The PRIVATE key never leaves the backend.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
